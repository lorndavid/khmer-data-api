# Environment Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_BASE_URL=http://localhost:4000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/khmerapi?schema=public"

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED=true
REDIS_TTL_SECONDS=3600

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_ANONYMOUS=60
RATE_LIMIT_DEVELOPER=300
RATE_LIMIT_ADMIN=1000
RATE_LIMIT_WINDOW_SECONDS=60

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:4000,https://khmerapi.dev,https://admin.khmerapi.dev"

# Logging
LOG_LEVEL=info
